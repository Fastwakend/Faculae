PRODUCT_BUNDLE_IDENTIFIER = $(SEEK_APP_BUNDLE_IDENTIFIER)
MARKETING_VERSION = 2.3.5
CURRENT_PROJECT_VERSION = 37
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
